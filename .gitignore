# Memory bank (architect's working memory + the process doc governing it)
# persists via the local folder + backups, not git (CLAUDE.md §2b).
/CLAUDE.md
/memory/

# Dev tooling -- deliberately kept out of version control (CLAUDE.md §2b).
/tools/
/.claude/
cleanup.bat
dev-py.bat
release.bat

# Scratch / task workspace.
/temp/

# Python rewrite (volt-py) -- venv/cache/dev-runtime are regenerated, never committed.
/volt-py/.venv/
/volt-py/**/__pycache__/
/volt-py/**/*.py[cod]
/volt-py/dev-app-root/

# Packaged release output.
/releases/

# OS cruft.
.DS_Store
Thumbs.db

# Brand/design source assets kept locally (alternate lockups, wordmarks, header sources); docs/brand/ holds only what GitHub shows.
/docs/app/
